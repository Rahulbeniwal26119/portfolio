---
import data from "../data.json";
import Section from "./Section.astro";

interface Props { index?: string }
const { index = "01" } = Astro.props;

// Keys double as button labels, and "blog" is a poor name for the publication.
const socialLabels: Record<string, string> = {
  blog: "TakoVibe",
  github: "GitHub",
  linkedin: "LinkedIn",
  medium: "Medium",
};
---

<Section id="contact" className="relative max-w-4xl mx-auto text-center">
  <div class="mb-12 flex flex-col items-center">
    <h2 class="section-heading">{index} / Contact</h2>
    <div class="mt-4 h-px w-28 bg-line"></div>
  </div>

  <div class="glass-panel p-8 md:p-12">
    <h3 class="text-4xl md:text-5xl font-heading font-semibold text-text mb-5">
      Let's build something useful.
    </h3>

    <p class="text-lg text-muted font-body mb-9 max-w-2xl mx-auto leading-relaxed">
      I'm open to backend engineering, AI integration, platform reliability, and product-minded engineering conversations.
    </p>

    <a href="https://takovibe.com/contact/" target="_blank" rel="noopener noreferrer" class="button-primary">
      Send Message
    </a>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      {Object.entries(data.hero?.social || {}).map(([platform, url]) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="button-secondary px-4 py-2 text-xs uppercase tracking-[0.12em]"
        >
          {socialLabels[platform] ?? platform}
        </a>
      ))}
    </div>
  </div>

  <footer class="mt-20 border-t border-line pt-8 text-sm text-muted">
    <p>{data.hero?.title} (c) {new Date().getFullYear()} - All Rights Reserved</p>
  </footer>
</Section>
