---

---

<button
    id="theme-toggle"
    aria-label="Toggle theme"
    class="fixed top-6 right-6 z-50 p-3 rounded-full bg-surface/80 backdrop-blur-md border border-black/5 shadow-lg text-text hover:bg-surface hover:scale-110 transition-all duration-300 dark:border-white/10 dark:text-white"
>
    <!-- Sun Icon (for Dark Mode) -->
    <svg
        class="w-6 h-6 hidden dark:block"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
    >
        <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
        ></path>
    </svg>

    <!-- Moon Icon (for Light Mode) -->
    <svg
        class="w-6 h-6 block dark:hidden"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
    >
        <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
        ></path>
    </svg>
</button>

<script>
    const themeToggle = document.getElementById("theme-toggle");

    // Initialize theme
    const getTheme = () => {
        if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
        ) {
            return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
    };

    const setTheme = (theme: string) => {
        if (theme === "dark") {
            document.documentElement.classList.add("dark");
        } else {
            document.documentElement.classList.remove("dark");
        }
        localStorage.setItem("theme", theme);
    };

    // Set initial theme
    setTheme(getTheme() || "light");

    // Toggle theme with circular reveal
    themeToggle?.addEventListener("click", async (e) => {
        const isDark = document.documentElement.classList.contains("dark");
        const newTheme = isDark ? "light" : "dark";

        // Fallback for browsers without View Transitions
        if (!document.startViewTransition) {
            setTheme(newTheme);
            return;
        }

        // Get click coordinates
        const x = e.clientX;
        const y = e.clientY;

        // Calculate radius to furthest corner
        const endRadius = Math.hypot(
            Math.max(x, innerWidth - x),
            Math.max(y, innerHeight - y),
        );

        // Create transition
        const transition = document.startViewTransition(() => {
            setTheme(newTheme);
        });

        // Wait for pseudo-elements to be created
        await transition.ready;

        // Animate the new view expanding
        document.documentElement.animate(
            {
                clipPath: [
                    `circle(0px at ${x}px ${y}px)`,
                    `circle(${endRadius}px at ${x}px ${y}px)`,
                ],
            },
            {
                duration: 500,
                easing: "ease-in-out",
                pseudoElement: "::view-transition-new(root)",
            },
        );
    });
</script>

<style is:global>
    ::view-transition-old(root),
    ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
    }

    ::view-transition-new(root) {
        z-index: 9999;
    }

    ::view-transition-old(root) {
        z-index: 1;
    }
</style>
