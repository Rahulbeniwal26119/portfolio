---
import data from "../data.json";
import Section from "./Section.astro";

interface Props { index?: string }
const { index = "01" } = Astro.props;
---

<Section id="experience" className="relative max-w-5xl mx-auto">
    <div class="mb-16">
        <h2 class="section-heading">{index} / Experience</h2>
        <div class="section-rule"></div>
    </div>

    <div class="relative pl-8 md:pl-12">
        <div class="absolute left-[3px] top-2 bottom-2 w-px bg-soft md:left-4">
            <div class="absolute top-0 h-28 w-full bg-gradient-to-b from-primary/60 to-transparent"></div>
        </div>

        <div class="space-y-10">
            {data.professionalExperience?.map((job) => (
                <div class="relative group">
                    <div class="absolute -left-10 top-7 z-10 h-4 w-4 rounded-full border-[3px] border-background bg-primary shadow-sm transition-transform duration-300 group-hover:scale-110 md:-left-[2.45rem]"></div>

                    <div class="glass-panel glass-panel-hover p-6 md:p-8">
                        <h3 class="text-2xl md:text-3xl font-heading font-semibold text-text mb-2">
                            {job.title}
                        </h3>
                        <div class="text-accent text-sm md:text-base mb-6 flex flex-col md:flex-row md:items-center gap-2 md:gap-4">
                            {job.companyUrl ? (
                                <a
                                    href={job.companyUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="transition-colors hover:text-primary"
                                >
                                    {job.company}
                                </a>
                            ) : (
                                <span>{job.company}</span>
                            )}
                            <span class="hidden md:inline text-muted/50">/</span>
                            <span>{job.period}</span>
                        </div>

                        {job.tech?.length ? (
                            <div class="flex flex-wrap gap-2 mb-8">
                                {job.tech.map((tech) => (
                                    <span class="chip">
                                        {tech}
                                    </span>
                                ))}
                            </div>
                        ) : null}

                        {job.highlights?.length ? (
                            <ul class="space-y-4">
                                {job.highlights.map((highlight) => (
                                    <li class="text-muted text-base leading-relaxed flex items-start gap-3">
                                        <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-primary/70"></span>
                                        <span>{highlight}</span>
                                    </li>
                                ))}
                            </ul>
                        ) : null}
                    </div>
                </div>
            ))}
        </div>
    </div>
</Section>
