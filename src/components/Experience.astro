--- import data from "../data.json"; import Section from "./Section.astro";
--- <Section id="experience">
    <h2
        class="text-6xl font-black font-display text-transparent bg-clip-text bg-gradient-to-r from-text to-text/50 mb-16 tracking-tight dark:from-white dark:to-white/50"
    >
        {data.sectionTitles?.experience}
    </h2>

    <div class="space-y-0 border-t border-black/10 dark:border-white/10">
        {data.professionalExperience?.map((job, index) => (
            <div class="group relative grid grid-cols-1 md:grid-cols-12 gap-8 py-12 border-b border-black/10 transition-colors hover:bg-black/5 dark:border-white/10 dark:hover:bg-white/5">
                <!-- Period -->
                <div class="md:col-span-3">
                    <span class="text-lg font-mono text-text-muted group-hover:text-text transition-colors dark:text-white/40 dark:group-hover:text-white/80">
                        {job.period}
                    </span>
                </div>

                <!-- Role & Company -->
                <div class="md:col-span-4">
                    <h3 class="text-2xl font-bold text-text mb-2 group-hover:translate-x-2 transition-transform duration-300 dark:text-white">
                        {job.title}
                    </h3>
                    <div class="text-xl text-text-muted dark:text-white/60">{job.company}</div>
                </div>

                <!-- Details -->
                <div class="md:col-span-5">
                    <ul class="space-y-2">
                        {job.highlights?.map((highlight) => (
                            <li class="text-text-muted text-base leading-relaxed group-hover:text-text transition-colors dark:text-white/50 dark:group-hover:text-white/70">
                                • {highlight}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        ))}
    </div>
</Section>
