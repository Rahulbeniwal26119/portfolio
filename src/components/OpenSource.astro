---
import data from "../data.json";
import Section from "./Section.astro";

interface Props { index?: string }
const { index = "01" } = Astro.props;
---

<Section id="open-source" className="relative max-w-7xl mx-auto">
    <div class="mb-16">
        <h2 class="section-heading">{index} / Open Source</h2>
        <div class="section-rule"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-16">
        {data.openSourceContributions?.map((contribution) => (
            <div class="glass-panel glass-panel-hover p-8 group relative overflow-hidden flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <span class="w-2 h-2 rounded-full bg-accent"></span>
                        <span class="text-[10px] font-semibold tracking-[0.14em] text-accent uppercase">Contribution</span>
                    </div>

            <a
              href={contribution.url}
              target="_blank"
              class="text-2xl font-heading font-semibold text-text group-hover:text-primary transition-colors duration-300 block mb-3"
            >
              {contribution.organization}
            </a>
            
            <p class="text-muted font-body leading-relaxed max-w-md">
              {contribution.description}
            </p>
          </div>

          <a href={contribution.url} target="_blank" class="mt-8 pt-4 border-t border-line flex items-center justify-between text-muted group-hover:text-primary transition-colors duration-300">
            <span class="text-xs font-semibold uppercase tracking-[0.14em]">View Contribution</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      ))
    }
  </div>
</Section>
