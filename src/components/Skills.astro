---
import data from "../data.json";
import Section from "./Section.astro";

interface Props { index?: string }
const { index = "01" } = Astro.props;
---

<Section id="skills" className="relative max-w-7xl mx-auto">
    <div class="mb-16">
        <h2 class="section-heading">{index} / Skills</h2>
        <div class="section-rule"></div>
    </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      Object.entries(data.skills || {}).map(([category, skills]) => (
        <div class="glass-panel glass-panel-hover p-8 group">
          <h3 class="text-lg font-semibold text-text mb-6 relative z-10 flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-accent/70"></span>
            {category}
          </h3>
          <div class="flex flex-wrap gap-2 relative z-10">
            {skills.map((skill) => (
              <span class="chip text-sm">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Section>
