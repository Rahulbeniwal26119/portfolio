---
import data from "../data.json";
import Section from "./Section.astro";
---

<Section id="skills">
    <h2
        class="text-4xl md:text-6xl font-black font-display text-transparent bg-clip-text bg-gradient-to-r from-text to-text/50 mb-16 tracking-tight dark:from-white dark:to-white/50"
    >
        {data.sectionTitles?.skills}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
            Object.entries(data.skills || {}).map(([category, skills]) => (
                <div class="bg-surface/30 rounded-lg p-6 hover:bg-surface/40 transition-all reveal-card border border-black/5 dark:border-white/5">
                    <h3 class="text-lg font-medium text-primary mb-4">
                        {category}
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        {skills.map((skill) => (
                            <span class="px-3 py-1 rounded-full bg-surface/50 text-sm text-text-muted border border-black/5 dark:border-white/5">
                                {skill}
                            </span>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</Section>
