---
import data from "../data.json";
import Section from "./Section.astro";
---

<Section id="writing" className="relative max-w-7xl mx-auto">
    <div class="mb-16">
        <h2 class="section-heading">04 / Writing</h2>
        <div class="section-rule"></div>
    </div>

  <div class="grid md:grid-cols-2 gap-8 mb-12">
    {
      data.writing?.platforms?.map((platform) => (
        <div class="glass-panel glass-panel-hover p-8 group flex flex-col justify-between">
          <div class="flex items-start justify-between mb-6">
            <h3 class="text-2xl font-heading font-semibold text-text group-hover:text-primary transition-colors">
              {platform.name}
            </h3>
            {platform.featured && (
              <span class="rounded-full border border-accent/20 bg-accent/5 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-accent">
                Featured
              </span>
            )}
          </div>
          <p class="text-muted font-body mb-8 leading-relaxed">
            {platform.description}
          </p>
          <a
            href={platform.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto group/btn flex items-center justify-between w-full pb-2 border-b border-white/10 hover:border-primary transition-colors"
          >
            <span class="text-sm font-semibold tracking-[0.08em] text-text group-hover/btn:text-primary transition-colors">Read</span>
            <svg class="w-4 h-4 text-muted group-hover/btn:text-primary group-hover/btn:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      ))
    }
  </div>

  {
    data.writing?.highlights && (
      <div class="glass-panel p-8 relative overflow-hidden group">
        <h3 class="text-sm font-semibold text-accent mb-6 uppercase tracking-[0.14em]">
          Core Topics
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {data.writing.highlights.map((highlight) => (
            <div class="flex items-start gap-3 rounded-lg border border-white/10 bg-white/5 p-3 transition-colors hover:border-primary/25">
              <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-primary/70"></span>
              <span class="text-muted font-body text-sm leading-relaxed">{highlight}</span>
            </div>
          ))}
        </div>
      </div>
    )
  }
</Section>
