---
import data from "../data.json";
import Section from "./Section.astro";

const studies = data.caseStudies ?? [];

interface Props { index?: string }
const { index = "01" } = Astro.props;
---

<Section id="case-studies" className="relative max-w-5xl mx-auto">
  <div class="mb-16">
    <h2 class="section-heading">{index} / Selected Work</h2>
    <div class="section-rule"></div>
  </div>

  <div class="space-y-8">
    {
      studies.map((study) => (
        <article class="glass-panel p-6 md:p-8">
          <header class="mb-6">
            <h3 class="font-heading text-2xl md:text-3xl font-semibold text-text">
              {study.title}
            </h3>
            <p class="mt-2 text-sm text-accent">
              {study.company} <span class="text-muted">/ {study.period}</span>
            </p>
          </header>

          {study.metrics?.length ? (
            <dl class="mb-8 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2">
              {study.metrics.map((m) => (
                <div class="bg-surface p-4">
                  <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">
                    {m.label}
                  </dt>
                  <dd class="mt-2 flex items-baseline gap-2 font-mono">
                    <span class="text-sm text-muted line-through decoration-muted/50">
                      {m.before}
                    </span>
                    <span aria-hidden="true" class="text-muted">&rarr;</span>
                    <span class="text-xl font-semibold text-text">{m.after}</span>
                    {m.delta && (
                      <span class="ml-auto text-xs font-semibold text-primary">
                        {m.delta}
                      </span>
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          ) : null}

          <div class="space-y-6">
            <div>
              <h4 class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-primary">
                Problem
              </h4>
              <p class="font-body leading-relaxed text-muted">{study.problem}</p>
            </div>

            <div>
              <h4 class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-primary">
                Approach
              </h4>
              <ol class="space-y-3">
                {study.approach?.map((step, i) => (
                  <li class="flex gap-3 font-body leading-relaxed text-muted">
                    <span class="mt-0.5 font-mono text-xs text-primary">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span>{step}</span>
                  </li>
                ))}
              </ol>
            </div>

            {study.tradeoff && (
              <div class="border-l-2 border-primary/40 pl-4">
                <h4 class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-primary">
                  Tradeoff
                </h4>
                <p class="font-body leading-relaxed text-muted">{study.tradeoff}</p>
              </div>
            )}
          </div>

          {study.tech?.length ? (
            <div class="mt-8 flex flex-wrap gap-2 border-t border-line pt-6">
              {study.tech.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </div>
          ) : null}
        </article>
      ))
    }
  </div>
</Section>
