---
import data from "../data.json";
import Hero from "./Hero.astro";
import Experience from "./Experience.astro";
import Projects from "./Projects.astro";
import OpenSource from "./OpenSource.astro";
import Writing from "./Writing.astro";
import Skills from "./Skills.astro";
import Education from "./Education.astro";
import Achievements from "./Achievements.astro";
import Contact from "./Contact.astro";
import ProjectModal from "./ProjectModal.astro";
import ScrollToTop from "./ScrollToTop.astro";

const { config } = data;
---

<div
  class="relative min-h-screen bg-background text-text transition-colors duration-300"
>
  {
    config?.underConstruction && (
      <div class="fixed top-0 left-0 w-full bg-yellow-500 text-black text-center py-2 z-50 animate-fade-in">
        Site under construction - updates coming soon.
      </div>
    )
  }
  <Hero />

  <!-- Main Content -->
  <div class="relative z-10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      {
        config?.sectionOrder?.map((sectionName) => {
          const isEnabled = config?.sections?.[sectionName as keyof typeof config.sections];
          if (!isEnabled) return null;

          switch (sectionName) {
            case "experience":
              return <Experience />;
            case "projects":
              return <Projects />;
            case "skills":
              return <Skills />;
            case "writing":
              return <Writing />;
            case "openSource":
              return <OpenSource />;
            case "achievements":
              return <Achievements />;
            case "education":
              return <Education />;
            case "contact":
              return <Contact />;
            default:
              return null;
          }
        })
      }
    </div>
  </div>

  <ProjectModal />
  <ScrollToTop />
</div>

<style>
  .animate-fade-in {
    animation: fadeIn 1s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
