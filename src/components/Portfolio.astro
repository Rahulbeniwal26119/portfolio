---
import data from "../data.json";
import Hero from "./Hero.astro";
import Experience from "./Experience.astro";
import CaseStudies from "./CaseStudies.astro";
import Projects from "./Projects.astro";
import OpenSource from "./OpenSource.astro";
import Writing from "./Writing.astro";
import Skills from "./Skills.astro";
import Education from "./Education.astro";
import Achievements from "./Achievements.astro";
import Contact from "./Contact.astro";
import ProjectModal from "./ProjectModal.astro";
import ScrollToTop from "./ScrollToTop.astro";

const { config } = data;

// Numbers are derived from the sections that are actually enabled, so turning
// one off renumbers the rest instead of leaving a gap in the sequence.
const visibleSections = (config?.sectionOrder ?? []).filter(
  (name: string) => config?.sections?.[name as keyof typeof config.sections],
);
const numberOf = (name: string) =>
  String(visibleSections.indexOf(name) + 1).padStart(2, "0");
---

<div
  class="relative min-h-screen bg-background text-text transition-colors duration-300"
>
  {
    config?.underConstruction && (
      <div class="fixed top-0 left-0 w-full bg-yellow-500 text-black text-center py-2 z-50 animate-fade-in">
        Site under construction - updates coming soon.
      </div>
    )
  }
  <Hero />

  <!-- Main Content -->
  <div class="relative z-10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      {
        config?.sectionOrder?.map((sectionName) => {
          const isEnabled = config?.sections?.[sectionName as keyof typeof config.sections];
          if (!isEnabled) return null;

          switch (sectionName) {
            case "experience":
              return <Experience index={numberOf("experience")} />;
            case "caseStudies":
              return <CaseStudies index={numberOf("caseStudies")} />;
            case "projects":
              return <Projects index={numberOf("projects")} />;
            case "skills":
              return <Skills index={numberOf("skills")} />;
            case "writing":
              return <Writing index={numberOf("writing")} />;
            case "openSource":
              return <OpenSource index={numberOf("openSource")} />;
            case "achievements":
              return <Achievements index={numberOf("achievements")} />;
            case "education":
              return <Education index={numberOf("education")} />;
            case "contact":
              return <Contact index={numberOf("contact")} />;
            default:
              return null;
          }
        })
      }
    </div>
  </div>

  <ProjectModal />
  <ScrollToTop />
</div>

<style>
  .animate-fade-in {
    animation: fadeIn 1s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
