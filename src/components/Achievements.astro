---
import data from "../data.json";
import Section from "./Section.astro";

interface Props { index?: string }
const { index = "01" } = Astro.props;
---

<Section id="achievements" className="relative max-w-7xl mx-auto">
  <div class="mb-16">
      <h2 class="section-heading">{index} / Achievements</h2>
      <div class="section-rule"></div>
  </div>

  <div class="grid md:grid-cols-2 gap-8">
    {
      data.achievements?.map((achievement) => (
        <div class="glass-panel glass-panel-hover p-8 flex gap-6 items-start group">
          <div class="w-14 h-14 rounded-lg flex-shrink-0 bg-primary/5 border border-primary/10 flex items-center justify-center text-2xl transition-colors duration-300 group-hover:bg-primary/10 group-hover:border-primary/25">
            {achievement.icon}
          </div>
          <div>
            <h3 class="text-xl font-heading font-semibold text-text mb-2 group-hover:text-primary transition-colors">
              {achievement.title}
            </h3>
            <p class="text-muted font-body leading-relaxed text-sm">
              {achievement.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</Section>
