---
import data from "../data.json";
import Section from "./Section.astro";
---

<Section id="achievements">
    <h2
        class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-text to-text/50 mb-12 dark:from-white dark:to-white/50"
    >
        {data.sectionTitles?.achievements}
    </h2>
    <div class="grid md:grid-cols-2 gap-8">
        {
            data.achievements?.map((achievement) => (
                <div class="bg-surface/30 rounded-lg p-6 hover:bg-surface/40 transition-all reveal-card border border-black/5 dark:border-white/5">
                    <div class="text-4xl mb-4">{achievement.icon}</div>
                    <h3 class="text-xl font-semibold text-text mb-2 dark:text-white">
                        {achievement.title}
                    </h3>
                    <p class="text-text-muted">{achievement.description}</p>
                </div>
            ))
        }
    </div>
</Section>
