---
import data from "../data.json";
import Section from "./Section.astro";
---

<Section id="achievements" className="relative max-w-7xl mx-auto py-24">
  <div class="mb-16">
      <h2 class="text-xl md:text-2xl font-mono text-primary tracking-widest uppercase mb-2">04.5 // ACHIEVEMENTS</h2>
      <div class="w-full h-px bg-gradient-to-r from-primary/30 to-transparent"></div>
  </div>

  <div class="grid md:grid-cols-2 gap-8">
    {
      data.achievements?.map((achievement) => (
        <div class="glass-panel p-8 flex gap-6 items-start group hover:border-primary/50 transition-colors duration-500">
          <div class="w-16 h-16 rounded flex-shrink-0 bg-white/5 border border-white/10 flex items-center justify-center text-3xl group-hover:bg-primary/20 group-hover:border-primary/50 transition-colors duration-500 shadow-[0_0_15px_rgba(0,0,0,0.5)]">
            {achievement.icon}
          </div>
          <div>
            <h3 class="text-xl font-heading font-bold text-white mb-2 tracking-wide group-hover:text-primary transition-colors">
              {achievement.title}
            </h3>
            <p class="text-muted font-body leading-relaxed text-sm">
              {achievement.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</Section>
