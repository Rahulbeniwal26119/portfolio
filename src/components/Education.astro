---
import data from "../data.json";
import Section from "./Section.astro";
---

<Section id="education">
    <h2
        class="text-4xl md:text-6xl font-black font-display text-transparent bg-clip-text bg-gradient-to-r from-text to-text/50 mb-16 tracking-tight dark:from-white dark:to-white/50"
    >
        {data.sectionTitles?.education}
    </h2>
    <div class="space-y-6 reveal-card">
        {
            data.education?.map((edu) => (
                <div class="bg-surface/30 rounded-lg p-6 border border-black/5 dark:border-white/5">
                    <h3 class="text-xl font-semibold text-text mb-2 dark:text-white">
                        {edu.degree}
                    </h3>
                    <div class="text-primary mb-2">{edu.institution}</div>
                    <div class="text-text-muted">{edu.period}</div>
                    <div class="text-text-muted mt-2">CGPA: {edu.cgpa}</div>
                    {edu.accomplishments && (
                        <div class="mt-4 flex flex-wrap gap-2">
                            {edu.accomplishments.map((item) => (
                                <span class="px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full border border-primary/20">
                                    {item}
                                </span>
                            ))}
                        </div>
                    )}
                </div>
            ))
        }
    </div>
</Section>
