---
import data from "../data.json";
import Section from "./Section.astro";

interface Props { index?: string }
const { index = "01" } = Astro.props;
---

<Section id="education" className="relative max-w-7xl mx-auto">
  <div class="mb-16">
      <h2 class="section-heading">{index} / Education</h2>
      <div class="section-rule"></div>
  </div>

  <div class="space-y-8">
    {
      data.education?.map((edu) => (
        <div class="glass-panel glass-panel-hover p-8 md:p-10">
          <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
            <div class="flex-1">
              <h3 class="text-2xl md:text-3xl font-heading font-semibold text-text mb-2 group-hover:text-primary transition-colors">
                {edu.degree}
              </h3>
              <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4 text-sm text-accent mb-6">
                <span class="text-primary">{edu.institution}</span>
                <span class="hidden md:inline text-muted/50">/</span>
                <span>{edu.period}</span>
              </div>

              {edu.accomplishments && (
                <div class="flex flex-wrap gap-2">
                  {edu.accomplishments.map((item) => (
                    <span class="chip">
                      {item}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <div class="mt-4 md:mt-0 flex flex-col items-start md:items-end w-full md:w-auto rounded-lg border border-line bg-soft p-4">
              <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted mb-1">GPA</span>
              <span class="text-3xl font-heading font-bold text-primary">{edu.cgpa}</span>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Section>
