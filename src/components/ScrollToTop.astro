---

---

<button
    id="scroll-to-top"
    aria-label="Scroll to top"
    class="fixed bottom-8 right-8 z-40 p-3 rounded-full bg-surface/80 backdrop-blur-md border border-black/5 shadow-lg text-text hover:bg-surface hover:scale-110 transition-all duration-300 opacity-0 translate-y-10 pointer-events-none dark:border-white/10 dark:text-white"
>
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
    </svg>
</button>

<script>
    const scrollBtn = document.getElementById("scroll-to-top");

    const toggleVisibility = () => {
        if (window.scrollY > 500) {
            scrollBtn?.classList.remove(
                "opacity-0",
                "translate-y-10",
                "pointer-events-none",
            );
        } else {
            scrollBtn?.classList.add(
                "opacity-0",
                "translate-y-10",
                "pointer-events-none",
            );
        }
    };

    const scrollToTop = () => {
        window.scrollTo({
            top: 0,
            behavior: "smooth",
        });
    };

    window.addEventListener("scroll", toggleVisibility);
    scrollBtn?.addEventListener("click", scrollToTop);
</script>
