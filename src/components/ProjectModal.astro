---

---

<div
    id="project-modal"
    class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300"
>
    <!-- Backdrop -->
    <div
        class="absolute inset-0 bg-black/70 backdrop-blur-md"
        id="modal-backdrop"
    >
    </div>

    <!-- Modal Content -->
    <div
        class="relative w-[95vw] h-[90vh] md:w-[90vw] md:h-[85vh] glass-panel overflow-hidden flex flex-col transform scale-95 transition-transform duration-300 bg-surface/95 backdrop-blur-[40px]"
        id="modal-content"
    >
        <!-- Browser Header -->
        <div
            class="h-12 border-b border-white/10 flex items-center px-4 gap-4 select-none bg-white/5"
        >
            <div class="flex gap-2">
                <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            </div>

            <!-- Address Bar -->
            <div class="flex-1 max-w-2xl mx-auto">
                <div
                    class="h-8 bg-background/70 rounded-lg border border-white/10 flex items-center px-3 text-xs text-muted gap-2"
                >
                    <svg
                        class="w-3 h-3"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                        ></path></svg
                    >
                    <span id="modal-url" class="truncate"
                        >https://example.com</span
                    >
                </div>
            </div>

            <!-- Actions -->
            <div class="flex gap-2">
                <a
                    href="#"
                    target="_blank"
                    id="modal-external-link"
                    class="p-2 hover:bg-white/10 rounded-lg text-muted hover:text-text transition-colors"
                    title="Open in new tab"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        ></path></svg
                    >
                </a>
                <button
                    id="modal-close"
                    class="p-2 hover:bg-white/10 rounded-lg text-muted hover:text-text transition-colors"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 18L18 6M6 6l12 12"></path></svg
                    >
                </button>
            </div>
        </div>

        <!-- Iframe Container -->
        <div class="flex-1 relative bg-white">
            <div
                id="modal-loader"
                class="absolute inset-0 flex items-center justify-center bg-surface z-10"
            >
                <div
                    class="w-8 h-8 border-2 border-primary border-t-transparent rounded-full animate-spin"
                >
                </div>
            </div>
            <iframe
                id="modal-iframe"
                class="w-full h-full border-0"
                sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
                loading="lazy"></iframe>
        </div>
    </div>
</div>

<script>
    const modal = document.getElementById("project-modal");
    const modalContent = document.getElementById("modal-content");
    const iframe = document.getElementById("modal-iframe") as HTMLIFrameElement;
    const urlDisplay = document.getElementById("modal-url");
    const externalLink = document.getElementById(
        "modal-external-link",
    ) as HTMLAnchorElement;
    const closeBtn = document.getElementById("modal-close");
    const backdrop = document.getElementById("modal-backdrop");
    const loader = document.getElementById("modal-loader");

    function openModal(url: string) {
        if (!modal || !iframe || !urlDisplay || !externalLink || !modalContent)
            return;

        iframe.src = url;
        urlDisplay.textContent = url;
        externalLink.href = url;

        // Reset loader
        if (loader) loader.style.display = "flex";

        iframe.onload = () => {
            if (loader) loader.style.display = "none";
        };

        modal.classList.remove("pointer-events-none", "opacity-0");
        modalContent.classList.remove("scale-95");
        document.body.style.overflow = "hidden";
    }

    function closeModal() {
        if (!modal || !iframe || !modalContent) return;

        modal.classList.add("opacity-0");
        modalContent.classList.add("scale-95");

        setTimeout(() => {
            modal.classList.add("pointer-events-none");
            iframe.src = "about:blank";
            document.body.style.overflow = "";
        }, 300);
    }

    // Event Listeners
    closeBtn?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);

    // Listen for custom event from other components
    document.addEventListener("open-project-preview", ((e: CustomEvent) => {
        if (e.detail?.url) {
            openModal(e.detail.url);
        }
    }) as EventListener);

    // Close on Escape
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeModal();
    });
</script>
