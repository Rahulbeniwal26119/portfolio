---
import data from "../data.json";

const primaryTech = ["Python", "Django", "AI Agents", "AWS", "PostgreSQL"];
const impactStats = [
  { value: "4+ yrs", label: "backend engineering" },
  { value: "30+", label: "integrations with top real estate & analytics brands" },
  { value: "60%", label: "faster deployment lead time" },
];
---

<section id="hero-section" class="relative isolate flex min-h-[92vh] w-full items-center overflow-hidden px-6 py-24 md:px-12">
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(rgba(37,99,235,0.055)_1px,transparent_1px),linear-gradient(90deg,rgba(37,99,235,0.055)_1px,transparent_1px)] bg-[size:44px_44px] [mask-image:linear-gradient(to_bottom,black,transparent_84%)]"></div>
  <div class="absolute inset-x-0 top-0 -z-10 h-72 bg-gradient-to-b from-primary/10 to-transparent"></div>

  <div class="mx-auto flex w-full max-w-6xl flex-col items-center text-center">
    <div class="eyebrow mb-8">
      <span class="h-2 w-2 rounded-full bg-accent"></span>
      Open for collaboration and knowledge sharing
    </div>

    <h1 class="max-w-5xl text-balance font-heading text-5xl font-semibold leading-[0.95] tracking-normal text-text sm:text-6xl md:text-7xl lg:text-8xl">
      {data.hero?.title}
    </h1>

    <p class="mt-6 text-balance text-xl font-medium leading-relaxed text-primary md:text-2xl">
      {data.hero?.subtitle}
    </p>

    <p class="mt-6 max-w-3xl text-base leading-8 text-muted md:text-lg">
      {data.hero?.summary}
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-2">
      {primaryTech.map((tech) => <span class="chip">{tech}</span>)}
    </div>

    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="https://resumevibe.takovibe.com/resume/rahulbeniwal26119/rahul-beniwal-senior-backend-engineer-ai-integration-specialist"
        target="_blank"
        rel="noopener noreferrer"
        class="button-primary"
      >
        View Resume
      </a>
      <a href="#projects" class="button-secondary">Explore Projects</a>
      <a href="#contact" class="button-secondary">Contact</a>
    </div>

    <div class="mt-16 grid w-full max-w-4xl grid-cols-1 overflow-hidden rounded-lg border border-white/10 bg-white/5 shadow-[var(--shadow-soft)] backdrop-blur md:grid-cols-3">
      {impactStats.map((stat) => (
        <div class="border-b border-white/10 px-6 py-5 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0">
          <div class="text-3xl font-semibold text-text">{stat.value}</div>
          <div class="mt-1 text-sm font-medium text-muted">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>

  <a
    href="#experience"
    aria-label="Scroll to experience"
    class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 rounded-full border border-white/10 bg-white/5 px-3 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-muted shadow-sm transition hover:text-primary md:inline-flex"
  >
    Scroll
  </a>
</section>
