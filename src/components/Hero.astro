---
import data from "../data.json";
---

<section id="hero-section" class="relative min-h-screen flex flex-col justify-center items-center overflow-hidden w-full bg-background selection:bg-primary/30">
    
    <!-- Background Orbital Rings / Quantum Core Visualization -->
    <div class="absolute inset-0 z-0 flex items-center justify-center pointer-events-none opacity-60">
        <!-- Giant glowing gradient behind everything -->
        <div class="absolute w-[80vw] h-[80vw] max-w-[800px] max-h-[800px] rounded-full bg-[radial-gradient(circle_at_center,rgba(0,229,255,0.08)_0%,transparent_70%)] blur-3xl"></div>
        
        <!-- Rotating Orbital Ring 1 -->
        <div class="absolute w-[60vw] h-[60vw] max-w-[600px] max-h-[600px] rounded-full border border-primary/20 animate-[spin_60s_linear_infinite] shadow-[0_0_60px_rgba(0,229,255,0.1)]">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-primary shadow-[0_0_20px_#00E5FF]"></div>
        </div>

        <!-- Rotating Orbital Ring 2 (Counter) -->
        <div class="absolute w-[80vw] h-[80vw] max-w-[800px] max-h-[800px] rounded-full border border-accent/20 animate-[spin_90s_linear_infinite_reverse] scale-90">
            <div class="absolute bottom-0 right-1/4 translate-x-1/2 translate-y-1/2 w-3 h-3 rounded-full bg-accent shadow-[0_0_15px_#B388FF]"></div>
        </div>
        
        <!-- Center Core Glow -->
        <div class="absolute w-32 h-32 rounded-full bg-primary/10 blur-xl animate-pulse"></div>
    </div>

    <!-- Foreground Content -->
    <div class="relative z-10 flex flex-col items-center max-w-5xl mx-auto px-6 text-center">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-3 px-4 py-2 mb-8 rounded-full border border-primary/30 bg-primary/5 backdrop-blur-md">
            <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-primary shadow-[0_0_8px_#00E5FF]"></span>
            </span>
            <span class="font-mono text-xs md:text-sm text-primary uppercase tracking-widest font-semibold">Available for work</span>
        </div>

        <!-- Heavy Tech Heading -->
        <h1 class="text-6xl md:text-8xl lg:text-[140px] font-heading font-bold text-transparent bg-clip-text bg-gradient-to-b from-white to-white/50 tracking-tighter leading-none mix-blend-plus-lighter pb-4 drop-shadow-[0_0_30px_rgba(255,255,255,0.1)] overflow-hidden">
            <span class="inline-block typing-animation">{data.hero?.title}</span>
        </h1>

        <!-- Subtitle -->
        <h2 class="text-xl md:text-3xl font-mono text-primary tracking-tight mt-6 mb-8 drop-shadow-[0_0_15px_rgba(0,229,255,0.4)]">
            > {data.hero?.subtitle} <span class="animate-pulse">_</span>
        </h2>

        <!-- Glassmorphic Terminal Summary -->
        <div class="glass-panel max-w-3xl p-6 md:p-8 mt-4 relative group">
            <div class="absolute top-0 left-4 -translate-y-1/2 bg-background px-2 text-[10px] font-mono tracking-widest text-muted group-hover:text-primary transition-colors">
                INFO
            </div>
            <p class="text-base md:text-lg font-body text-text-muted leading-relaxed font-light">
                {data.hero?.summary}
            </p>
        </div>

        <!-- Action Matrix -->
        <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6 mt-12 w-full max-w-3xl">
            <a href="https://resumevibe.takovibe.com/resume/rahulbeniwal26119/rahul-beniwal-senior-backend-engineer-ai-integration-specialist" target="_blank" rel="noopener noreferrer" class="group relative px-8 py-4 bg-primary text-[#05020A] font-mono font-bold tracking-widest uppercase text-sm rounded-none overflow-hidden hover:shadow-[0_0_40px_rgba(0,229,255,0.4)] transition-all duration-300">
                <!-- Glitch/Scanline effect on hover -->
                <div class="absolute inset-0 w-full h-full bg-[linear-gradient(transparent_50%,rgba(0,0,0,0.1)_50%)] bg-[length:100%_4px] opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
                <span class="relative z-10 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    View Resume
                </span>
            </a>
            
            <a href="#projects" class="group px-8 py-4 border border-white/20 text-white font-mono font-semibold tracking-widest uppercase text-sm rounded-none hover:bg-white/10 hover:border-white/50 transition-all duration-300 relative overflow-hidden backdrop-blur-md">
                <div class="absolute inset-0 translate-y-[100%] group-hover:translate-y-0 bg-primary/20 transition-transform duration-300 ease-in-out z-0"></div>
                <span class="relative z-10 group-hover:text-primary transition-colors">Projects</span>
            </a>
            
            <a href={`mailto:${data.hero?.contacts?.email}`} class="group px-8 py-4 border border-white/20 text-white font-mono font-semibold tracking-widest uppercase text-sm rounded-none hover:bg-white/10 hover:border-white/50 transition-all duration-300 relative overflow-hidden backdrop-blur-md">
                <div class="absolute inset-0 translate-y-[100%] group-hover:translate-y-0 bg-primary/20 transition-transform duration-300 ease-in-out z-0"></div>
                <span class="relative z-10 group-hover:text-primary transition-colors">Contact Me</span>
            </a>
        </div>
    </div>
    
    <!-- Vertical Scroll Line Indicator -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 flex flex-col items-center">
        <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted mb-4 rotate-90 origin-bottom translate-y-[-200%] opacity-50">Scroll</span>
        <div class="w-[1px] h-24 bg-gradient-to-b from-primary/50 to-transparent relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1/3 bg-primary animate-[slide-down_2s_ease-in-out_infinite] shadow-[0_0_10px_#00E5FF]"></div>
        </div>
    </div>
</section>

<style>
    .typing-animation {
        border-right: 2px solid transparent;
        white-space: nowrap;
        overflow: hidden;
        animation: typing 2.5s steps(40, end), blink-caret .75s step-end infinite;
        width: 100%;
        max-width: fit-content;
    }

    @keyframes typing {
        from { width: 0 }
        to { width: 100% }
    }

    @keyframes slide-down {
        0% { transform: translateY(-100%) }
        100% { transform: translateY(300%) }
    }
</style>
