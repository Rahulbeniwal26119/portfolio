---
import data from "../data.json";
import Section from "./Section.astro";
---

<Section id="projects">
    <h2
        class="text-6xl font-black font-display text-transparent bg-clip-text bg-gradient-to-r from-text to-text/50 mb-16 tracking-tight dark:from-white dark:to-white/50"
    >
        {data.sectionTitles?.projects}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[300px]">
        {data.projects?.map((project, index) => (
            <div
                class={`group relative rounded-3xl overflow-hidden bg-surface/50 border border-black/5 hover:border-black/10 transition-all duration-500 hover:shadow-2xl hover:shadow-black/5 dark:bg-neutral-900/50 dark:border-white/10 dark:hover:border-white/20 dark:hover:shadow-white/5 ${
                    (index % 4 === 0 || index % 4 === 3) ? "md:col-span-2" : ""
                }`}
            >
                <!-- Background Gradient/Image Placeholder -->
                <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-50 group-hover:opacity-70 transition-opacity duration-500 dark:from-white/5"></div>
                
                <!-- Content -->
                <div class="absolute inset-0 p-8 flex flex-col justify-between z-10">
                    <div class="transform transition-transform duration-500 group-hover:-translate-y-2">
                        <div class="flex justify-between items-start mb-4">
                            <h3 class="text-3xl font-bold text-text tracking-tight dark:text-white">{project.name}</h3>
                            <a href={project.url} target="_blank" class="p-2 bg-black/5 rounded-full hover:bg-black/10 text-text transition-colors opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 duration-300 dark:bg-white/10 dark:hover:bg-white dark:text-black">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
                            </a>
                        </div>
                        <p class="text-text-muted text-lg line-clamp-2 dark:text-white/60">{project.description}</p>
                    </div>

                    <div class="transform transition-transform duration-500 translate-y-4 group-hover:translate-y-0 flex items-end justify-between">
                        <div class="flex flex-wrap gap-2">
                            {project.techTags?.map((tech) => (
                                <span class="px-3 py-1 text-xs font-medium bg-white/50 border border-black/5 rounded-full text-text-muted backdrop-blur-sm dark:bg-white/5 dark:border-white/10 dark:text-white/80">
                                    {tech}
                                </span>
                            ))}
                        </div>
                        
                        {project.preview && (
                            <button
                                data-preview-url={project.url}
                                class="preview-btn px-4 py-2 bg-primary text-white text-sm font-medium rounded-lg shadow-lg shadow-primary/20 hover:bg-primary/90 transition-all active:scale-95 flex items-center gap-2"
                            >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                Preview
                            </button>
                        )}
                    </div>
                </div>
            </div>
        ))}
    </div>
</Section>

<script>
    document.addEventListener('astro:page-load', () => {
        const buttons = document.querySelectorAll('.preview-btn');
        buttons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const url = btn.getAttribute('data-preview-url');
                if (url) {
                    document.dispatchEvent(new CustomEvent('open-project-preview', {
                        detail: { url }
                    }));
                }
            });
        });
    });
    
    // Fallback for non-ViewTransitions
    const buttons = document.querySelectorAll('.preview-btn');
    buttons.forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const url = btn.getAttribute('data-preview-url');
            if (url) {
                document.dispatchEvent(new CustomEvent('open-project-preview', {
                    detail: { url }
                }));
            }
        });
    });
</script>
